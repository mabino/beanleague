# ==============================================================================
# BeanLeague Environment Configuration
# Copy this file to .env and configure your variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. External Data Sources (API-Football)
# ------------------------------------------------------------------------------
# API-Football v3 API Key (from https://dashboard.api-football.com/)
# If left empty, BeanLeague automatically operates in Curated Mock Mode
# with top European stars and realistic matchday simulation feeds.
API_FOOTBALL_KEY=

# Base URL for API-Football (v3)
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Hard daily limit on external API requests (Free tier is 100 req/day)
# The built-in request auditor blocks requests exceeding this cap to prevent overages.
API_DAILY_LIMIT=100

# Target League IDs for daily fixture & squad sync (e.g. 140 = La Liga, 39 = Premier League, 2 = UCL)
TARGET_LEAGUE_IDS=[140, 39]

# Target Season year for fixtures/stats (e.g. 2026)
TARGET_SEASON=2026

# ------------------------------------------------------------------------------
# 2. League Defaults & Rules
# ------------------------------------------------------------------------------
# Default Season Code created on fresh database bootstrap
DEFAULT_SEASON_CODE=BARCA-2026
DEFAULT_LEAGUE_NAME=Barca & Friends Fantasy League
DEFAULT_SALARY_CAP=100.0

# ------------------------------------------------------------------------------
# 3. Cron & Background Scheduler
# ------------------------------------------------------------------------------
# Enable APScheduler for 03:00 AM Seeder & 15-min Matchday Poller
ENABLE_SCHEDULER=true

# Polling interval in minutes during active matches (15-20 recommended for free tier)
POLL_INTERVAL_MINUTES=15

# ------------------------------------------------------------------------------
# 4. Server & Storage
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DATA_DIR=/app/data
DATABASE_PATH=/app/data/beanleague.db
